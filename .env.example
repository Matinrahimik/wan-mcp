# Alibaba Cloud Model Studio (DashScope) credentials.
# Get an API key: https://www.alibabacloud.com/help/en/model-studio/get-api-key
DASHSCOPE_API_KEY=sk-your-dashscope-api-key
WAN_WORKSPACE_ID=your-model-studio-workspace-id

# singapore or beijing. Defaults to singapore if omitted.
WAN_REGION=singapore

# Where SUCCEEDED mp4 files are written. Defaults to ./wan-output in the current working directory.
WAN_OUTPUT_DIR=./wan-output

# Optional: path to a JSON file with api_key, workspace_id, and region.
# WAN_SECRETS_FILE=/absolute/path/to/wan.json

# Optional: directory containing <id>/wan.json files (used when env vars are incomplete).
# WAN_SECRETS_ROOT=/absolute/path/to/secrets

# Optional: subdirectory name under WAN_SECRETS_ROOT when several wan.json files exist.
# WAN_AGENT_ID=

# Set to 1 in tests. Refuses live Model Studio HTTP unless an httpx client is injected.
# WAN_TEST_MODE=1
